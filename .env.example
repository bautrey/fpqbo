# QuickBooks Online API Credentials
# Copy this to .env and fill in your values

# OAuth2 App Credentials (from Intuit Developer Portal)
QBO_CLIENT_ID=your_client_id_here
QBO_CLIENT_SECRET=your_client_secret_here

# Company/Realm ID
QBO_COMPANY_ID=1208415120
QBO_REALM_ID=1208415120

# OAuth2 Tokens (obtained through OAuth flow)
QBO_ACCESS_TOKEN=your_access_token_here
QBO_REFRESH_TOKEN=your_refresh_token_here

# Redirect URI (for OAuth flow)
QBO_REDIRECT_URI=https://developer.intuit.com/v2/OAuth2Playground/RedirectUrl

# Environment (sandbox or production)
QBO_ENVIRONMENT=production
